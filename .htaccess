RewriteEngine On

# Il progetto ora vive su mrrearm.it/magazine. Questo deploy su Render resta
# attivo solo come "ponte": chiunque arrivi qui (dal vecchio indirizzo
# actuality-jt1z.onrender.com, o dal vecchio sottodominio magazine.mrrearm.it
# se il DNS punta ancora qui) viene rediretto in modo permanente al nuovo
# indirizzo definitivo, mantenendo lo stesso percorso e parametri.
RewriteRule ^(.*)$ https://mrrearm.it/magazine/$1 [R=301,L,QSA]
